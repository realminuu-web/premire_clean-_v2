# [프리미어 클린] 환경 변수 예시
# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 GitHub 에 올라가지 않습니다)
# 자세한 설명: src/config/ADMIN_GUIDE.md 의 [1. 처음 설정]
# 카카오톡 상담 주소는 이제 관리자 페이지 [문구 수정] > [전화번호 · 카톡]에서 바꿉니다.

# 관리자 페이지 (/admin) — 서버에만 있고 손님에게 보이지 않습니다
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Supabase (관리자에서 고친 글·후기·사진·통계 저장소)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 실제 홈페이지 주소 (검색엔진용)
NEXT_PUBLIC_SITE_URL=https://premierclean.co.kr

# EmailJS (견적 신청 이메일 알림 — 마지막 단계에서 연결)
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
